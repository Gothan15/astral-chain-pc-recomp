#version 450
// CMAA 2 (runtime/vk_preset.c): porte del CMAA_2.fx (Intel, Apache 2.0; porte a ReShade de Lord Of Lunacy)
// a compute. Pasos LongEdge y ApplyPS del original, en forma de recogida (gather) en vez de dispersión: el
// original dibuja cada línea Z sobre los candidatos procesados con mezcla aditiva (cada fragmento suma el
// color del otro lado del borde ×2.25 y 2.25 de peso); aquí cada píxel de borde busca los centros Z cuya
// línea lo cubre — en su fila si la Z es horizontal, en su columna si es vertical — y acumula exactamente
// las mismas aportaciones con la misma interpolación (LongEdgePS). Al final, como en el ApplyPS, el color
// es la suma ponderada dividida por su peso si el peso pasa de 0.5; si no, el píxel queda como estaba.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;        // el color de entrada
layout(binding = 1) uniform sampler2D candidates; // los candidatos procesados de cmaa_process.comp
layout(binding = 2) uniform sampler2D zshapes;    // las formas Z empaquetadas
layout(binding = 3, rgba16f) uniform writeonly image2D dst;
layout(binding = 4) uniform sampler2D edges;      // los bordes empaquetados de cmaa_edges.comp
layout(push_constant) uniform P {
    ivec2 offset;   // la esquina del rectángulo de recorte en src
    ivec2 size;     // su tamaño, el tamaño de dst
    vec4 pad;
} pc;

uint LoadEdge(ivec2 q) {
    return uint(texelFetch(edges, clamp(q, ivec2(0), pc.size - 1), 0).r * 255.5);
}

// La aportación de una línea Z a este píxel, con la matemática del LongEdgePS del original: i es la
// posición del píxel a lo largo de la línea (0 = el centro Z) y la muestra se toma al otro lado del borde,
// interpolada según i y amortiguada por la longitud total de la línea.
void contribute(inout vec4 acc, ivec2 sp, vec4 packedZ, int i, bool horizontal) {
    uvec4 temp = uvec4(packedZ * 255.5);   // unpackZ del original
    bool zh = ((temp.w >> 1) & 1u) != 0u;
    if (zh != horizontal) return;
    bool invertedZ = (temp.w & 1u) != 0u;
    float shapeQualityScore = float(temp.z);
    float lineLengthLeft = float(temp.x);
    float lineLengthRight = float(temp.y);

    vec2 blendDir = horizontal ? vec2(0.0, -1.0) : vec2(-1.0, 0.0);
    if (invertedZ) blendDir = -blendDir;
    float leftOdd = 0.22 * mod(lineLengthLeft, 2.0);    // c_symmetryCorrectionOffset del original
    float rightOdd = 0.22 * mod(lineLengthRight, 2.0);
    float dampenEffect = clamp((lineLengthLeft + lineLengthRight - shapeQualityScore) * 0.15, 0.0, 1.0);
    float loopFrom = -floor((lineLengthLeft + 1.0) / 2.0) + 1.0;
    float loopTo = floor((lineLengthRight + 1.0) / 2.0);
    if (float(i) < loopFrom || float(i) > loopTo) return;
    float totalLength = (loopTo - loopFrom) + 1.0 - leftOdd - rightOdd;
    float lerpStep = 1.0 / totalLength;
    float lerpFromK = (0.5 - leftOdd - loopFrom) * lerpStep;
    float lerpVal = lerpStep * float(i) + lerpFromK;
    bool secondPart = i > 0;
    float srcOffset = 1.0 - (secondPart ? 2.0 : 0.0);
    float lerpK = (lerpVal * srcOffset + (secondPart ? 1.0 : 0.0)) * dampenEffect;
    vec2 samplePos = vec2(sp) + 0.5 + blendDir * srcOffset * lerpK;
    vec3 col = textureLod(src, samplePos / vec2(textureSize(src, 0)), 0.0).rgb;
    acc.rgb += col * 2.25;
    acc.a += 2.25;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    ivec2 sp = p + pc.offset;
    vec3 srcCol = texelFetch(src, sp, 0).rgb;
    vec4 acc = texelFetch(candidates, p, 0);
    if ((LoadEdge(p) & 15u) != 0u) {   // las líneas solo cubren píxeles del propio borde
        // centros Z horizontales en esta fila: el centro está en p - i*(1,0)
        for (int i = -64; i <= 64; i++) {
            ivec2 cpos = p + ivec2(-i, 0);
            if (cpos.x < 0 || cpos.x >= pc.size.x) continue;
            vec4 z = texelFetch(zshapes, cpos, 0);
            if (z.w > 3.9 / 255.0) contribute(acc, sp, z, i, true);
        }
        // centros Z verticales en esta columna: el centro está en p - i*(0,-1) = p + (0,i)
        for (int i = -64; i <= 64; i++) {
            ivec2 cpos = p + ivec2(0, i);
            if (cpos.y < 0 || cpos.y >= pc.size.y) continue;
            vec4 z = texelFetch(zshapes, cpos, 0);
            if (z.w > 3.9 / 255.0) contribute(acc, sp, z, i, false);
        }
    }
    vec3 outc = (acc.a > 0.5) ? acc.rgb / acc.a : srcCol;
    imageStore(dst, p, vec4(outc, 1.0));
}
