#version 450
// CMAA 2 (runtime/vk_preset.c): porte del CMAA_2.fx (Intel, Apache 2.0; porte a ReShade de Lord Of Lunacy)
// a compute. Paso EdgesPS del original, en su modo CMAA2_MLAA_EDGE_DETECTION=1 (el que activa el preset
// ELZELDAPA) y con el umbral del ajuste de calidad HIGH (0.07): detecta los bordes por diferencia de color
// ponderada por luma, descarta los que quedan por debajo de la mitad del contraste local máximo y empaqueta
// los cuatro bordes (derecha, abajo, izquierda, arriba) más el bit de candidato en un byte.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;   // la esquina del rectángulo de recorte en src
    ivec2 size;     // su tamaño, el tamaño de dst
    vec4 pad;
} pc;

// EdgeDetectColorCalcDiff del original
float edgeDiff(vec3 a, vec3 b) { return dot(abs(a - b), vec3(0.299, 0.587, 0.114)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    ivec2 sp = p + pc.offset;
    ivec2 lo = pc.offset, hi = pc.offset + pc.size - 1;
    // el 3×3 del original, acotado al rectángulo (fuera de él se repite el borde)
    #define F(dx, dy) texelFetch(src, clamp(sp + ivec2(dx, dy), lo, hi), 0).rgb
    vec3 e = F(0, 0);
    vec4 edges = vec4(edgeDiff(e, F(1, 0)), edgeDiff(e, F(0, 1)), edgeDiff(e, F(-1, 0)), edgeDiff(e, F(0, -1)));
    // el contraste local del modo MLAA: cada borde sobrevive solo si llega a la mitad del mayor de los cuatro
    float localContrast = max(max(edges.x, edges.y), max(edges.z, edges.w)) * 0.5;
    edges *= step(localContrast, edges);
    edges = vec4(greaterThan(edges, vec4(0.07)));
    // candidato: al menos una esquina de dos bordes (una forma simple o compleja que procesar)
    bool isCandidate = (edges.x * edges.y + edges.y * edges.z + edges.z * edges.w + edges.w * edges.x) != 0.0;
    float packed = (dot(edges, vec4(1.0, 2.0, 4.0, 8.0)) + (isCandidate ? 16.0 : 0.0)) / 255.0;
    imageStore(dst, p, vec4(packed, 0.0, 0.0, 0.0));
}
