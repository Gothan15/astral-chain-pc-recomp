#version 450
// CMAA 2 (runtime/vk_preset.c): porte del CMAA_2.fx (Intel, Apache 2.0; porte a ReShade de Lord Of Lunacy)
// a compute. Paso ProcessEdges del original (su ruta compute, sin la lista de candidatos: aquí cada píxel
// candidato hace el mismo trabajo que hacía allí el hilo que lo recogía): para cada candidato calcula el
// color mezclado de su forma simple (BlendSimpleShape, con ComputeSimpleShapeBlendValues en código, como la
// ruta compute del original) y detecta si es la esquina de una forma en Z larga (DetectComplexShapes),
// trazando la línea por los bordes hasta 128 píxeles. Escribe los candidatos procesados (RGBA16F: el color
// ponderado y su peso en alfa) y las formas Z empaquetadas (RGBA8).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;    // el color de entrada (texelFetch)
layout(binding = 1) uniform sampler2D edges;  // los bordes empaquetados de cmaa_edges.comp (R8)
layout(binding = 2, rgba16f) uniform writeonly image2D candidates;
layout(binding = 3, rgba8) uniform writeonly image2D zshapes;
layout(push_constant) uniform P {
    ivec2 offset;   // la esquina del rectángulo de recorte en src
    ivec2 size;     // su tamaño
    vec4 pad;
} pc;

// LoadEdge del original, acotado al rectángulo (fuera de él se repite el borde)
uint LoadEdge(ivec2 q) {
    return uint(texelFetch(edges, clamp(q, ivec2(0), pc.size - 1), 0).r * 255.5);
}

// UnpackEdgesFlt del original: (derecha, abajo, izquierda, arriba) como 0/1
vec4 UnpackEdgesFlt(uint value) {
    return vec4(float(value & 1u), float((value >> 1) & 1u), float((value >> 2) & 1u), float((value >> 3) & 1u));
}

vec3 LoadSourceColor(ivec2 q) {
    return texelFetch(src, pc.offset + clamp(q, ivec2(0), pc.size - 1), 0).rgb;
}

// ComputeSimpleShapeBlendValues del original, con sus constantes de la ruta sin EXTRA_SHARPNESS:
// bluriness 0.10 y amortiguación saturate(1.30 - bordesAlrededor/10). dontTestShapeValidity llega siempre
// a true desde BlendSimpleShape, así que ese bloque no se porta.
vec4 ComputeSimpleShapeBlendValues(vec4 edges, vec4 edgesLeft, vec4 edgesRight, vec4 edgesTop, vec4 edgesBottom) {
    float fromRight = edges.r;
    float fromBelow = edges.g;
    float fromLeft = edges.b;
    float fromAbove = edges.a;
    float blurCoeff = 0.10;
    float numberOfEdges = dot(edges, vec4(1.0));
    float numberOfEdgesAllAround = dot(edgesLeft.bga + edgesRight.rga + edgesTop.rba + edgesBottom.rgb, vec3(1.0));
    // forma de escalón en L: se refuerzan los lados que continúan la esquina
    if (numberOfEdges == 2.0) {
        blurCoeff *= 0.75;
        float k = 0.9;
        fromRight += k * (edges.g * edgesTop.r * (1.0 - edgesLeft.g) + edges.a * edgesBottom.r * (1.0 - edgesLeft.a));
        fromBelow += k * (edges.b * edgesRight.g * (1.0 - edgesTop.b) + edges.r * edgesLeft.g * (1.0 - edgesTop.r));
        fromLeft += k * (edges.a * edgesBottom.b * (1.0 - edgesRight.a) + edges.g * edgesTop.b * (1.0 - edgesRight.g));
        fromAbove += k * (edges.r * edgesLeft.a * (1.0 - edgesBottom.r) + edges.b * edgesRight.a * (1.0 - edgesBottom.b));
    }
    // con muchos bordes alrededor se amortigua: conserva texto y detalle fino
    blurCoeff *= clamp(1.30 - numberOfEdgesAllAround / 10.0, 0.0, 1.0);
    return vec4(fromLeft, fromAbove, fromRight, fromBelow) * blurCoeff;
}

// BlendSimpleShape del original: el color del píxel mezclado con sus cuatro vecinos según los valores
vec4 BlendSimpleShape(ivec2 coord, vec4 edges, vec4 edgesLeft, vec4 edgesRight, vec4 edgesBottom, vec4 edgesTop) {
    vec4 blendVal = ComputeSimpleShapeBlendValues(edges, edgesLeft, edgesRight, edgesTop, edgesBottom);
    float centerWeight = 1.0 - dot(blendVal, vec4(1.0));
    vec3 outColor = LoadSourceColor(coord) * centerWeight;
    outColor += (blendVal.x > 0.0) ? blendVal.x * LoadSourceColor(coord + ivec2(-1, 0)) : vec3(0.0);
    outColor += (blendVal.y > 0.0) ? blendVal.y * LoadSourceColor(coord + ivec2(0, -1)) : vec3(0.0);
    outColor += (blendVal.z > 0.0) ? blendVal.z * LoadSourceColor(coord + ivec2(1, 0)) : vec3(0.0);
    outColor += (blendVal.w > 0.0) ? blendVal.w * LoadSourceColor(coord + ivec2(0, 1)) : vec3(0.0);
    return vec4(outColor, 1.0);
}

// DetectZsHorizontal del original: puntúa la Z normal y la invertida sobre los bordes dados
void DetectZsHorizontal(vec4 edges, vec4 edgesM1P0, vec4 edgesP1P0, vec4 edgesP2P0,
                        out float invertedZScore, out float normalZScore) {
    invertedZScore = edges.r * edges.g * edgesP1P0.a;
    invertedZScore *= 2.0 + (edgesM1P0.g + edgesP2P0.a) - (edges.a + edgesP1P0.g) -
                      0.7 * (edgesP2P0.g + edgesM1P0.a + edges.b + edgesP1P0.r);
    normalZScore = edges.r * edges.a * edgesP1P0.g;
    normalZScore *= 2.0 + (edgesM1P0.a + edgesP2P0.g) - (edges.g + edgesP1P0.a) -
                    0.7 * (edgesP2P0.a + edgesM1P0.g + edges.b + edgesP1P0.r);
}

// FindZLineLengths del original: sigue el borde en las dos direcciones hasta que se corta o hasta que un
// lado se despega del otro (factor 1.25 sin EXTRA_SHARPNESS); el máximo es c_maxLineLength = 128
void FindZLineLengths(out float lineLengthLeft, out float lineLengthRight, ivec2 screenPos, bool horizontal,
                      bool invertedZShape, vec2 stepRight) {
    uint maskTraceLeft, maskTraceRight;
    if (horizontal) {
        maskTraceLeft = 0x08u;    // sigue el borde de arriba
        maskTraceRight = 0x02u;   // sigue el borde de abajo
    } else {
        maskTraceLeft = 0x04u;    // sigue el borde de la izquierda
        maskTraceRight = 0x01u;   // sigue el borde de la derecha
    }
    if (invertedZShape) {
        uint temp = maskTraceLeft;
        maskTraceLeft = maskTraceRight;
        maskTraceRight = temp;
    }
    bool continueLeft = true;
    bool continueRight = true;
    lineLengthLeft = 1.0;
    lineLengthRight = 1.0;
    while (true) {
        uint edgeLeft = LoadEdge(screenPos + ivec2(-stepRight * lineLengthLeft));
        uint edgeRight = LoadEdge(screenPos + ivec2(stepRight * (lineLengthRight + 1.0)));
        continueLeft = continueLeft && ((edgeLeft & maskTraceLeft) != 0u);
        continueRight = continueRight && ((edgeRight & maskTraceRight) != 0u);
        lineLengthLeft += continueLeft ? 1.0 : 0.0;
        lineLengthRight += continueRight ? 1.0 : 0.0;
        float maxLR = (!continueLeft && !continueRight) ? 128.0 : max(lineLengthRight, lineLengthLeft);
        if (maxLR >= min(128.0, 1.25 * min(lineLengthRight, lineLengthLeft) - 0.25)) break;
    }
}

// packZ del original: longitudes, calidad y orientación en un RGBA8 (con el +4 que usa la ruta compute)
vec4 packZ(bool horizontal, bool invertedZ, float shapeQualityScore, float lineLengthLeft, float lineLengthRight) {
    return vec4(lineLengthLeft, lineLengthRight, shapeQualityScore,
                (horizontal ? 2.0 : 0.0) + (invertedZ ? 1.0 : 0.0) + 4.0) / 255.0;
}

// DetectComplexShapes del original (la versión en código de la ruta compute): busca la Z horizontal y la
// vertical (rotando los bordes con .argb) y, si alguna puntúa, traza sus longitudes
vec4 DetectComplexShapes(ivec2 coord, vec4 edges, vec4 edgesLeft, vec4 edgesRight, vec4 edgesBottom, vec4 edgesTop) {
    float invertedZScore = 0.0;
    float normalZScore = 0.0;
    float maxScore = 0.0;
    bool horizontal = true;
    bool invertedZ = false;
    // horizontal
    {
        vec4 edgesP2P0 = UnpackEdgesFlt(LoadEdge(coord + ivec2(2, 0)));
        DetectZsHorizontal(edges, edgesLeft, edgesRight, edgesP2P0, invertedZScore, normalZScore);
        maxScore = max(invertedZScore, normalZScore);
        if (maxScore > 0.0) invertedZ = invertedZScore > normalZScore;
    }
    // vertical: la misma búsqueda rotada 90° (izquierda pasa a abajo, arriba a izquierda, etc.)
    {
        vec4 edgesP2P0 = UnpackEdgesFlt(LoadEdge(coord + ivec2(0, -2)));
        DetectZsHorizontal(edges.argb, edgesBottom.argb, edgesTop.argb, edgesP2P0.argb, invertedZScore, normalZScore);
        float vertScore = max(invertedZScore, normalZScore);
        if (vertScore > maxScore) {
            maxScore = vertScore;
            horizontal = false;
            invertedZ = invertedZScore > normalZScore;
        }
    }
    if (maxScore > 0.0) {
        float shapeQualityScore = floor(clamp(4.0 - maxScore, 0.0, 3.0));   // 0: la mejor; 2-3: dudosa
        vec2 stepRight = horizontal ? vec2(1.0, 0.0) : vec2(0.0, -1.0);
        float lineLengthLeft, lineLengthRight;
        FindZLineLengths(lineLengthLeft, lineLengthRight, coord, horizontal, invertedZ, stepRight);
        lineLengthLeft -= shapeQualityScore;
        lineLengthRight -= shapeQualityScore;
        if (lineLengthLeft + lineLengthRight >= 5.0)
            return packZ(horizontal, invertedZ, shapeQualityScore, lineLengthLeft, lineLengthRight);
    }
    return vec4(0.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec4 cand = vec4(0.0);
    vec4 z = vec4(0.0);
    uint packed = LoadEdge(p);
    if (packed > 16u) {   // candidato con al menos un borde (el bit 16 más algún bit de borde)
        vec4 edges = UnpackEdgesFlt(packed);
        vec4 edgesLeft = UnpackEdgesFlt(LoadEdge(p + ivec2(-1, 0)));
        vec4 edgesRight = UnpackEdgesFlt(LoadEdge(p + ivec2(1, 0)));
        vec4 edgesBottom = UnpackEdgesFlt(LoadEdge(p + ivec2(0, 1)));
        vec4 edgesTop = UnpackEdgesFlt(LoadEdge(p + ivec2(0, -1)));
        cand = BlendSimpleShape(p, edges, edgesLeft, edgesRight, edgesBottom, edgesTop);
        z = DetectComplexShapes(p, edges, edgesLeft, edgesRight, edgesBottom, edgesTop);
    }
    imageStore(candidates, p, cand);
    imageStore(zshapes, p, z);
}
