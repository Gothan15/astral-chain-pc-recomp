#version 450
// Colourfulness (preset ELZELDAPA, runtime/vk_preset.c): porte del shader Colourfulness.fx de bacondither
// (licencia BSD, ver vk_preset.c) a compute. Ajusta cuánto se aleja cada color de su propio luma: con el valor
// del preset (-0.30) desatura, con valores positivos satura protegiendo los extremos con un límite suave.
// La ruta fast_luma=1 del original (la de por defecto) y sin dithering (el preset lo lleva apagado).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;   // la esquina del rectángulo de recorte en src
    ivec2 size;     // su tamaño, el tamaño de dst
    vec4 par;       // x: colourfulness (-1..2), y: lim_luma (0.1..1)
} pc;

// soft_lim del original: sigmoid que acota v sin pasar de s, conservando el signo
vec3 soft_lim(vec3 v, vec3 s) { return (v * s) / sqrt(s * s + v * v); }

// wpmean del original: media potencial ponderada con p = 0.5, por componente
vec3 wpmean(vec3 a, vec3 b, float w) {
    return pow(abs(w) * sqrt(abs(a)) + abs(1.0 - w) * sqrt(abs(b)), vec3(2.0));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    float colourfulness = pc.par.x;
    float lim_luma = pc.par.y;
    const vec3 lumacoeff = vec3(0.2558, 0.6511, 0.0931);   // media de los coeficientes 709 y 601 del original

    vec3 c0 = texelFetch(src, p + pc.offset, 0).rgb;
    float luma = sqrt(dot(clamp(c0 * abs(c0), 0.0, 1.0), lumacoeff));   // fast_luma: aproximación gamma rápida
    c0 = clamp(c0, 0.0, 1.0);

    vec3 diff_luma = c0 - luma;
    vec3 c_diff = diff_luma * colourfulness;   // el original: diff_luma*(colourfulness+1) - diff_luma

    if (colourfulness > 0.0) {
        // 120 % de la diferencia acotada al rango visible + sobreimpulso
        vec3 rlc_diff = clamp(c_diff * 1.2 + c0, -0.0001, 1.0001) - c0;
        // aumento máximo de saturación sin alterar las proporciones RGB
        float poslim = (1.0002 - luma) / (abs(max(diff_luma.r, max(diff_luma.g, diff_luma.b))) + 0.0001);
        float neglim = (luma + 0.0002) / (abs(min(diff_luma.r, min(diff_luma.g, diff_luma.b))) + 0.0001);
        vec3 diffmax = diff_luma * min(min(poslim, neglim), 32.0) - diff_luma;
        // límite suave de la diferencia
        c_diff = soft_lim(c_diff, max(wpmean(diffmax, rlc_diff, lim_luma), vec3(1e-7)));
    }

    imageStore(dst, p, vec4(clamp(c0 + c_diff, 0.0, 1.0), 1.0));
}
