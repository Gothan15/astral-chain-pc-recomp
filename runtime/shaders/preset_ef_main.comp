#version 450
// ExposureFusion (preset ELZELDAPA, runtime/vk_preset.c): porte de MartysMods_EXPOSUREFUSION.fx de Pascal
// Gilcher (propietario, solo para el fork privado de Gothan; ver vk_preset.c). Paso MainPS del original:
// ajusta el sesgo fundido a la guía local con una regresión lineal sobre el 3×3 del nivel fundido, suma el
// objetivo de exposición y aplica el resultado como un factor 2^sesgo sobre el color expandido a HDR, que
// vuelve a SDR por la curva inversa. Las funciones de conversión se repiten de preset_ef_init.comp.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D fused;   // la pirámide fundida (RG16F, tamaño del nivel 0)
layout(binding = 1) uniform sampler2D src;     // el color de entrada
layout(binding = 2, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;     // la esquina del rectángulo de recorte en src
    ivec2 size;       // el tamaño del recorte (la resolución completa)
    ivec2 fusedSize;  // el tamaño del nivel fundido
    float intensity;  // INTENSITY del preset (0.5)
    float target;     // EXPOSURE_TARGET del preset (0.3)
} pc;

// Solape de conos del original y su inversa (matrices simétricas)
vec3 cone_overlap(vec3 c) {
    float k = 0.4 * 0.33;
    vec2 f = vec2(1.0 - 2.0 * k, k);
    mat3 m = mat3(f.x, f.y, f.y, f.y, f.x, f.y, f.y, f.y, f.x);
    return c * m;
}
vec3 cone_overlap_inv(vec3 c) {
    float k = 0.4 * 0.33;
    vec2 f = vec2(k - 1.0, k) * (1.0 / (3.0 * k - 1.0));
    mat3 m = mat3(f.x, f.y, f.y, f.y, f.x, f.y, f.y, f.y, f.x);
    return c * m;
}

vec3 sdr_to_hdr(vec3 c) {
    c = cone_overlap(c);
    c = c * sqrt(1e-6 + dot(c, c)) / 1.733;
    float a = 1.0 + exp2(-12.0);   // WHITEPOINT = 12 del original
    c = c / (a - c);
    return c;
}

vec3 hdr_to_sdr(vec3 c) {
    float a = 1.0 + exp2(-12.0);
    c = a * c / (1.0 + c);
    c *= 1.733;
    c = c * inversesqrt(sqrt(dot(c, c)) + 0.0001);
    c = cone_overlap_inv(c);
    return clamp(c, 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
    // regresión lineal guía→sesgo sobre el 3×3 del fundido, con pesos gaussianos (el MainPS del original)
    vec4 m = vec4(0.0);
    float ws = 0.0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            vec2 t = textureLod(fused, uv + vec2(float(x), float(y)) / vec2(pc.fusedSize), 0.0).xy;
            float w = exp(-float(x * x + y * y));
            m += vec4(t.y, t.y * t.y, t.y * t.x, t.x) * w;
            ws += w;
        }
    m /= ws;
    float a = (m.z - m.x * m.w) / (max(m.y - m.x * m.x, 0.0) + 0.00001);
    float b = m.w - a * m.x;

    vec3 col = textureLod(src, (vec2(pc.offset) + vec2(p) + 0.5) / vec2(textureSize(src, 0)), 0.0).rgb;
    float guide = dot(vec3(0.3333), col);
    float bias = a * guide + b;
    // el objetivo de exposición, pasado por la misma expansión a HDR que el color
    vec3 target_hdr = sdr_to_hdr(vec3(pc.target));
    float target_loglum = dot(vec3(0.3333), log2(max(vec3(1e-3), target_hdr)));
    bias += target_loglum * abs(pc.intensity);

    vec3 o = sdr_to_hdr(col);
    o *= exp2(bias);
    o = hdr_to_sdr(o);
    imageStore(dst, p, vec4(o, 1.0));
}
